# Paynomenon configuration. Copy to .env (make setup does this and generates random secrets) and adjust.
# NEVER commit .env. Values below are placeholders, not real credentials.

# ---- environment -------------------------------------------------------------------------------------------------
# development | production. In production the simulation endpoints, demo users, Swagger UI and seeding are all refused.
PAYNOMENON_ENV=development

# ---- PostgreSQL ----------------------------------------------------------------------------------------------------
POSTGRES_DB=paynomenon
POSTGRES_USER=paynomenon
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# ---- backend secrets (generate long random values; `make setup` does this for you) ------------------------------------
PAYNOMENON_JWT_SECRET=change-me-at-least-32-characters-long-jwt-secret
PAYNOMENON_SERVICE_TOKEN=change-me-service-token          # lets the AI service persist detected anomalies
PAYNOMENON_CALLBACK_SECRET=change-me-callback-secret      # HMAC key for simulated processor webhooks
PAYNOMENON_METRICS_USER=prometheus
PAYNOMENON_METRICS_PASSWORD=change-me-metrics-password    # HTTP Basic credentials for /actuator/prometheus
PAYNOMENON_TRACE_SAMPLING=0.1                            # OpenTelemetry trace sampling probability

# ---- development accounts (ignored when PAYNOMENON_ENV=production) ------------------------------------------------------
PAYNOMENON_DEMO_USERS_ENABLED=true
PAYNOMENON_DEMO_VIEWER_PASSWORD=viewer-demo-pass
PAYNOMENON_DEMO_INVESTIGATOR_PASSWORD=investigator-demo-pass
PAYNOMENON_DEMO_ADMIN_PASSWORD=admin-demo-pass

# ---- processor simulation (development only) --------------------------------------------------------------------------
PAYNOMENON_SIMULATION_ENABLED=true

# ---- event transport -----------------------------------------------------------------------------------------------------
# kafka (docker compose default) | in-process (no broker; local development without Docker)
PAYNOMENON_EVENTS_TRANSPORT=kafka
PAYNOMENON_KAFKA_BOOTSTRAP=localhost:9092

# ---- ports ---------------------------------------------------------------------------------------------------------------
BACKEND_PORT=8080
AI_PORT=8090
FRONTEND_PORT=3000

# ---- AI service ----------------------------------------------------------------------------------------------------------
# Shared secret between the backend and the AI service.
AI_INTERNAL_TOKEN=change-me-ai-internal-token
# mock (default: deterministic, no network, no key) | anthropic | openai_compatible
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5-5
# Required for anthropic / openai_compatible. Stays on the server: it is never sent to the browser or logged.
AI_API_KEY=
# openai_compatible: base URL including the version prefix, e.g. https://api.openai.com/v1 ; optional override for anthropic
AI_API_BASE_URL=
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1200
# Test hook for the mock provider: normal | timeout | rate_limited | unavailable | malformed | fabricate | inject | unsafe_claim
AI_MOCK_MODE=normal

# ---- Grafana (observability profile) --------------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-grafana
